<manifest xmlns:android="http://schemas.android.com/apk/res/android">

  <!-- Benachrichtigungen zeigen (ab Android 13 fragt die App einmal nach) -->
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <!-- Erinnerungen genau zur Uhrzeit. Der Nutzer erlaubt das einmal in den Einstellungen (ab Android 12).
       USE_EXACT_ALARM erlaubt Google Play nur Weckern und Kalendern, deshalb nicht verwenden. -->
  <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
  <!-- Nach dem Einschalten des Handys die Erinnerungen wieder planen -->
  <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
  <!-- Vollbild wie ein Wecker über dem Sperrbildschirm. Ab Android 14 erlaubt der Nutzer das selbst;
       ohne Erlaubnis zeigt Android eine normale Benachrichtigung. In der Play Console erklären. -->
  <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
  <!-- Vibration beim Vollbild -->
  <uses-permission android:name="android.permission.VIBRATE" />

  <application>
    <receiver android:name="de.aaron.birthdays.alarms.AlarmReceiver" android:exported="false" />
    <receiver android:name="de.aaron.birthdays.alarms.ActionReceiver" android:exported="false" />
    <receiver android:name="de.aaron.birthdays.alarms.SystemReceiver" android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.BOOT_COMPLETED" />
        <action android:name="android.intent.action.TIMEZONE_CHANGED" />
        <action android:name="android.intent.action.TIME_SET" />
        <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
        <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
      </intent-filter>
    </receiver>
    <activity
      android:name="de.aaron.birthdays.alarms.AlarmActivity"
      android:exported="false"
      android:excludeFromRecents="true"
      android:launchMode="singleInstance"
      android:showWhenLocked="true"
      android:turnScreenOn="true"
      android:taskAffinity=""
      android:theme="@android:style/Theme.Material.Light.NoActionBar" />
  </application>
</manifest>
